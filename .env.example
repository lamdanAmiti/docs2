# ─── Required env vars for production (Coolify Environment Variables tab) ───

# Supabase (shared instance running on this server)
SUPABASE_URL=https://your-supabase-instance.example.com
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-jwt-here

# Iron-session cookie secret (32+ chars). Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-openssl-rand-hex-32-output

# Collabora admin (for the /browser/dist/admin/admin.html console)
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=replace-with-strong-password

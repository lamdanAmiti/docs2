# Custom Collabora image for docs.velr.app:
#   1. Strips all default bundled fonts so only ours appear in the picker.
#   2. Bakes our custom fonts into /opt/cool/systemplate/ so the chroot-jailed
#      "kit" rendering processes can see them.
#   3. Injects a velr-overrides.css stylesheet into cool.html so the editor
#      chrome matches the Velr Docs / Tiptap design (color tokens, Inter
#      font, Google Docs-style toolbar buttons).
FROM collabora/code:latest

USER root

# 1. Strip default bundled fonts (keep Liberation Sans + Carlito for UI chrome)
RUN find /opt/collaboraoffice/share/fonts -type f \( -name '*.ttf' -o -name '*.otf' \) \
        ! -name 'LiberationSans-*' \
        ! -name 'Carlito-*' \
        -delete && \
    rm -rf /usr/share/fonts/truetype/dejavu \
           /opt/cool/systemplate/usr/share/fonts/truetype/dejavu

# 2. Bake our fonts into the image AND into the systemplate so the jails see them
COPY public/fonts/hebrew/  /usr/share/fonts/truetype/velr-hebrew/
COPY public/fonts/english/ /usr/share/fonts/truetype/velr-english/
COPY public/fonts/hebrew/  /opt/cool/systemplate/usr/share/fonts/truetype/velr-hebrew/
COPY public/fonts/english/ /opt/cool/systemplate/usr/share/fonts/truetype/velr-english/

# 3. Velr CSS overrides + Instrument Sans for the UI AND the document.
COPY public/collabora-theme/velr-overrides.css /usr/share/coolwsd/browser/dist/velr-overrides.css
COPY public/collabora-theme/fonts/ /usr/share/coolwsd/browser/dist/fonts/
# Also bundle Instrument Sans into the chroot jail so it's available as a
# *document* font (not just for the UI). Collabora's font picker will list it.
COPY public/collabora-theme/fonts/ /usr/share/fonts/truetype/velr-instrument/
COPY public/collabora-theme/fonts/ /opt/cool/systemplate/usr/share/fonts/truetype/velr-instrument/

RUN sed -i 's|<link rel="stylesheet" href="%SERVICE_ROOT%/browser/%VERSION%/bundle.css" />|<link rel="stylesheet" href="%SERVICE_ROOT%/browser/%VERSION%/bundle.css" />\n<link rel="stylesheet" href="%SERVICE_ROOT%/browser/%VERSION%/velr-overrides.css" />|' \
        /usr/share/coolwsd/browser/dist/cool.html

# 4. Bake an explicit alias_groups block into coolwsd.xml. The env-var
#    aliasgroup1 mechanism produces a regex like "https://host:443" that
#    Collabora's WOPI host matcher fails against incoming URLs without
#    explicit port. A hostname-only pattern in mode="groups" reliably
#    matches both forms.
RUN sed -i 's|<alias_groups desc="[^"]*" mode="first">|<alias_groups mode="groups"><group><host allow="true">docs\\.velr\\.app</host></group>|' \
        /etc/coolwsd/coolwsd.xml

# 5. Refresh fontconfig cache so the editor advertises the new set immediately
RUN fc-cache -fv >/dev/null 2>&1 || true

USER cool

# Custom Collabora image: strips all default bundled fonts so only the
# Hebrew fonts mounted into /usr/share/fonts/truetype/velr-hebrew/ are
# visible in the editor's font picker.
#
# We keep Liberation Sans + Carlito alive because Collabora's UI text
# itself renders with them — deleting those would break the toolbar
# rendering, not just the document fonts.
FROM collabora/code:latest

USER root

RUN set -eux; \
    # Remove every bundled .ttf/.otf except the ones the UI needs.
    find /opt/collaboraoffice/share/fonts -type f \( -name '*.ttf' -o -name '*.otf' \) \
        ! -name 'LiberationSans-*' \
        ! -name 'Carlito-*' \
        -delete; \
    # The "common" fonts dir holds the opens___.ttf default — keep it,
    # Collabora falls back to it for unknown glyphs.
    # Wipe the DejaVu system fonts entirely.
    rm -rf /usr/share/fonts/truetype/dejavu; \
    # Refresh the font cache so the editor only advertises what's left
    # plus whatever is mounted at runtime.
    fc-cache -fv >/dev/null 2>&1 || true

USER cool
